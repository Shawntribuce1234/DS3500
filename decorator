def timer(func):
    """A decorator that prints how long a function took to run."""
    @functools.wraps(func) # this preserves the docstring and name of the original function
    def wrapper(*args, **kwargs):
        start_time = datetime.datetime.now()
        result = func(*args, **kwargs) # this is how you call the original function with the same arguments
        func()
        end_time = datetime.datetime.now()
        print(f"Time taken: {end_time - start_time:.4f} seconds")
        return result
    return wrapper


def validate_input(required_cols):
    """A decorator that takes a list of columns as input and checks
    if they are in the dataframe when building the wrapper."""
    def decorator(func):
        @functools.wraps(func)
        def wrapper(df, *args, **kwargs):
            missing_cols = [col for col in required_cols if col not in df.columns]
            if missing_cols:
                raise ValueError(f"Missing columns are {missing_cols}")
            return func(df, *args, **kwargs)
        return wrapper
    pass

@timer

def load_data(fp):
    df = pd.read_csv(fp)
    return df

@validate_input(required_cols=["neighborhood", "on_time"])
def get_neighborhoods(df):
    """Return list of neighborhoods with 'All' as the first option."""
    vals = df["neighborhood"].fillna("Unknown").unique().tolist()
    vals_sorted = sorted(vals, key=str.lower)
    return ["All"] + vals_sorted

@validate_input(required_cols=["on_time"])
def percent_resolved_on_time(df):
    """Compute percentage of cases resolved on time.
    """
    on_time_count = len(df[df["on_time"] == "ONTIME"])
    percent = (on_time_count / len(df)) * 100
    return round(percent, 2)
