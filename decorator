# a simple function to start wrapping


def shout(func):
    """A decorator that announces when a function starts and finishes.
    Have this return a function."""
    @functools.wraps(func) # this preserves the docstring and name of the original function
    def wrapper():
        print(f"BEGINNING {func.__name__}!")
        func()
        print("FINISHED!")
        pass
    return wrapper

@shout
def say_hello():
    """Say hello to the class."""
    print("Hey DS3500")

